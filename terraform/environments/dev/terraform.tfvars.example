# Copy this file to terraform.tfvars and fill in real values
# DO NOT commit terraform.tfvars to git

aws_region          = "us-east-1"
domain_name         = "dev.yourdomain.com"
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/YOUR-CERT-ID"
service_a_image_tag = "latest"
service_b_image_tag = "latest"
